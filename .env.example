KIWI_HOST=0.0.0.0
KIWI_API_PORT=3333
KIWI_WEB_ORIGIN=http://localhost:4173
KIWI_DATA_DIR=./data

# Optional tag metadata providers. Wikidata/Wikipedia need no API key.
STASH_BOX_ENDPOINT=https://stashdb.org/graphql
STASH_BOX_API_KEY=
TPDB_ENDPOINT=https://theporndb.net/graphql
TPDB_API_KEY=

# Web downloads. Binaries are found in KIWI_DATA_DIR/bin, then PATH, unless set here.
# KIWI_YTDLP_PATH=/usr/local/bin/yt-dlp
# KIWI_WIREPROXY_PATH=/usr/local/bin/wireproxy
# KIWI_DOWNLOAD_CONCURRENCY=2
# KIWI_DOWNLOADER_PLUGINS_DIR=./data/plugins/downloaders
